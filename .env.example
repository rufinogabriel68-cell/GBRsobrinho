# ---------------------------------------------------------------------------
# GBR Soluções — modelo de variáveis de ambiente
# Copie para `.env.local` (uso local) ou cole na Vercel em
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# ============================ BANCO DE DADOS ==============================
# Escolha UMA das duas opções. Se as duas existirem, o app usa Firestore.
# Sem nenhuma delas o app abre em MODO DEMONSTRAÇÃO: funciona, mas guarda os
# dados só na memória do servidor (some ao reiniciar). Para forçar esse modo,
# defina DB_DRIVER=demo.

# --- Opção A (recomendada): Firebase / Firestore --------------------------
# Cole o JSON inteiro da conta de serviço em UMA linha (veja o guia).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
#
# Alternativa: três variáveis separadas
# FIREBASE_PROJECT_ID=gbr-solucoes
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@gbr-solucoes.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Configuração pública do app (aparece no console do Firebase):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gbr-solucoes.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=gbr-solucoes
# NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Opção B: Postgres (Neon, Supabase, Railway…) -------------------------
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
# DB_DRIVER=postgres

# ============================== PROTEÇÃO ==================================
# Senha única do painel. Sem esta variável o app fica aberto para quem tiver
# o endereço — defina uma senha antes de usar no dia a dia.
# APP_PASSWORD=minha-senha-boa

# ============================== ENDEREÇO ==================================
# Usado nos links de portal enviados ao cliente (senão usa o domínio atual).
# NEXT_PUBLIC_SITE_URL=https://gbr-solucoes.vercel.app

# ====================== INTEGRAÇÕES OPCIONAIS =============================
# Z-API_INSTANCE_ID=
# Z-API_INSTANCE_TOKEN=
