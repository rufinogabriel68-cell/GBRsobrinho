# ============================================================================
# GBR Sobrinho — variáveis de ambiente do Firebase
# ============================================================================
# Copie este arquivo para `.env.local` e preencha com os dados do SEU projeto.
#
# Onde encontrar: https://console.firebase.google.com
#   1. Selecione (ou crie) seu projeto
#   2. engrenagem ⚙️ → "Configurações do projeto"
#   3. Role até "Seus apps" → app Web (</>) → copie o objeto `firebaseConfig`
#
# Enquanto estas variáveis estiverem vazias, o painel roda em MODO
# DEMONSTRAÇÃO (dados fictícios salvos no navegador), sem Firebase.
# ============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=SEU_PROJETO.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=SEU_PROJETO.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
